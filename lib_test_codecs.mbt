// ---------------------------------------------------------------------------
// PNG
// ---------------------------------------------------------------------------

///|
test "png: decode_png reads a 1x1 RGBA8 image" {
  let img = decode_png(fixture_png_tiny_1x1_rgba()) catch {
    _ => fail("decode_png raised on a 1x1 RGBA PNG")
  }
  assert_eq(img.width, 1)
  assert_eq(img.height, 1)
  assert_eq(pixel_format_name(img.format), "RGBA8")
  assert_eq(img.data.length(), 4)
}

///|
test "png: decode_png expands an indexed (palette) image to RGBA8" {
  let img = decode_png(fixture_png_palette_16x16()) catch {
    _ => fail("decode_png raised on an indexed PNG")
  }
  assert_eq(img.width, 16)
  assert_eq(img.height, 16)
  // Colour type 3 (indexed) has no direct pixel format; the decoder
  // expands the palette to RGBA8.
  assert_eq(pixel_format_name(img.format), "RGBA8")
  assert_eq(img.data.length(), 16 * 16 * 4)
}

///|
test "png: decode_png reads a 32x32 RGBA8 image" {
  let img = decode_png(fixture_png_gradient_32x32()) catch {
    _ => fail("decode_png raised on a 32x32 RGBA PNG")
  }
  assert_eq(img.width, 32)
  assert_eq(img.height, 32)
  assert_eq(pixel_format_name(img.format), "RGBA8")
  assert_eq(img.data.length(), 32 * 32 * 4)
}

///|
test "png: image_dimensions reads IHDR without decoding pixels" {
  let (w, h, fmt) = image_dimensions(fixture_png_palette_16x16()) catch {
    _ => fail("image_dimensions raised on a PNG")
  }
  assert_eq(w, 16)
  assert_eq(h, 16)
  assert_eq(image_format_name(fmt), "PNG")
}

///|
test "png: detect_format identifies the PNG magic" {
  let name = match detect_format(fixture_png_gradient_32x32()) {
    Some(f) => image_format_name(f)
    None => "?"
  }
  assert_eq(name, "PNG")
}

// ---------------------------------------------------------------------------
// GIF
// ---------------------------------------------------------------------------

///|
test "gif: decode_gif reads a 1x1 image" {
  let img = decode_gif(fixture_gif_tiny_1x1()) catch {
    _ => fail("decode_gif raised on a 1x1 GIF")
  }
  assert_eq(img.width, 1)
  assert_eq(img.height, 1)
  assert_eq(pixel_format_name(img.format), "RGBA8")
}

///|
test "gif: decode_gif reads a 32x32 palette image" {
  let img = decode_gif(fixture_gif_palette_32x32()) catch {
    _ => fail("decode_gif raised on a 32x32 GIF")
  }
  assert_eq(img.width, 32)
  assert_eq(img.height, 32)
  assert_eq(pixel_format_name(img.format), "RGBA8")
  assert_eq(img.data.length(), 32 * 32 * 4)
}

///|
test "gif: decode_gif_all returns every frame of an animated GIF" {
  // The 8x8 sample carries two Graphic Control Extensions, i.e. two
  // frames. decode_gif() would only return the first one.
  let anim = decode_gif_all(fixture_gif_animated_8x8()) catch {
    _ => fail("decode_gif_all raised on an animated GIF")
  }
  assert_eq(anim.frame_count(), 2)
  assert_eq(anim.width, 8)
  assert_eq(anim.height, 8)
  let first = anim.frames[0]
  assert_eq(first.width, 8)
  assert_eq(first.height, 8)
}

///|
test "gif: detect_format identifies the GIF magic" {
  let name = match detect_format(fixture_gif_palette_32x32()) {
    Some(f) => image_format_name(f)
    None => "?"
  }
  assert_eq(name, "GIF")
}

// ---------------------------------------------------------------------------
// TGA
// ---------------------------------------------------------------------------

///|
test "tga: decode_tga reads a 1x1 24-bit image" {
  let img = decode_tga(fixture_tga_tiny_1x1_24()) catch {
    _ => fail("decode_tga raised on a 1x1 TGA")
  }
  assert_eq(img.width, 1)
  assert_eq(img.height, 1)
  // 24-bit true colour has no alpha, so it is widened to RGBA8.
  assert_eq(pixel_format_name(img.format), "RGBA8")
}

///|
test "tga: decode_tga maps an 8-bit grayscale image to Gray8" {
  let img = decode_tga(fixture_tga_grayscale_32x32()) catch {
    _ => fail("decode_tga raised on a grayscale TGA")
  }
  assert_eq(img.width, 32)
  assert_eq(img.height, 32)
  assert_eq(pixel_format_name(img.format), "Gray8")
  assert_eq(img.data.length(), 32 * 32)
}

///|
test "tga: decode_tga reads a 32x32 RGBA image" {
  let img = decode_tga(fixture_tga_rgba_32x32()) catch {
    _ => fail("decode_tga raised on an RGBA TGA")
  }
  assert_eq(img.width, 32)
  assert_eq(img.height, 32)
  assert_eq(pixel_format_name(img.format), "RGBA8")
  assert_eq(img.data.length(), 32 * 32 * 4)
}

///|
test "tga: detect_format identifies a TGA carrying the v2 footer" {
  // Regression guard for the off-by-one in the v2 footer scan: the
  // signature is 17 bytes but the scan used to walk 18, indexing past
  // the end of the string and panicking.
  let name = match detect_format(fixture_tga_rgba_32x32()) {
    Some(f) => image_format_name(f)
    None => "?"
  }
  assert_eq(name, "TGA")
}

///|
test "tga: image_dimensions reads the TGA header" {
  let (w, h, fmt) = image_dimensions(fixture_tga_rgba_32x32()) catch {
    _ => fail("image_dimensions raised on a TGA")
  }
  assert_eq(w, 32)
  assert_eq(h, 32)
  assert_eq(image_format_name(fmt), "TGA")
}

// ---------------------------------------------------------------------------
// JPEG
// ---------------------------------------------------------------------------

///|
test "jpeg: decode_jpeg reads a 1x1 baseline image" {
  let img = decode_jpeg(fixture_jpeg_tiny_1x1()) catch {
    _ => fail("decode_jpeg raised on a 1x1 JPEG")
  }
  assert_eq(img.width, 1)
  assert_eq(img.height, 1)
  assert_eq(pixel_format_name(img.format), "RGB8")
}

///|
test "jpeg: decode_jpeg reads a 64x64 baseline colour image" {
  let img = decode_jpeg(fixture_jpeg_natural_64x64()) catch {
    _ => fail("decode_jpeg raised on a 64x64 JPEG")
  }
  assert_eq(img.width, 64)
  assert_eq(img.height, 64)
  assert_eq(pixel_format_name(img.format), "RGB8")
  assert_eq(img.data.length(), 64 * 64 * 3)
}

///|
test "jpeg: decode_jpeg reads the high-quality 64x64 sample" {
  let img = decode_jpeg(fixture_jpeg_hq_64x64()) catch {
    _ => fail("decode_jpeg raised on the HQ JPEG")
  }
  assert_eq(img.width, 64)
  assert_eq(img.height, 64)
  assert_eq(pixel_format_name(img.format), "RGB8")
}

///|
test "jpeg: the two 64x64 samples decode to different pixels" {
  // Both samples are 64x64 baseline colour. If the decoder collapsed
  // them to the same buffer (e.g. a stale cache or a wrong stride) the
  // images would be identical, which would mean one of them was not
  // really decoded.
  let a = decode_jpeg(fixture_jpeg_natural_64x64()) catch {
    _ => fail("decode_jpeg raised on the natural JPEG")
  }
  let b = decode_jpeg(fixture_jpeg_hq_64x64()) catch {
    _ => fail("decode_jpeg raised on the HQ JPEG")
  }
  let mut differ = false
  for i = 0; i < a.data.length(); i = i + 1 {
    if a.data[i] != b.data[i] {
      differ = true
      break
    }
  }
  assert_true(differ)
}

///|
test "jpeg: detect_format identifies the JPEG magic" {
  let name = match detect_format(fixture_jpeg_natural_64x64()) {
    Some(f) => image_format_name(f)
    None => "?"
  }
  assert_eq(name, "JPEG")
}

// ---------------------------------------------------------------------------
// Cross-codec: the unified entry points route each format correctly
// ---------------------------------------------------------------------------

///|
test "codec matrix: decode() routes every JPEG / PNG / GIF / TGA sample" {
  let png = decode(fixture_png_gradient_32x32()) catch {
    _ => fail("decode() raised on a PNG")
  }
  assert_eq((png.width, png.height), (32, 32))
  let gif = decode(fixture_gif_palette_32x32()) catch {
    _ => fail("decode() raised on a GIF")
  }
  assert_eq((gif.width, gif.height), (32, 32))
  let tga = decode(fixture_tga_rgba_32x32()) catch {
    _ => fail("decode() raised on a TGA")
  }
  assert_eq((tga.width, tga.height), (32, 32))
  let jpeg = decode(fixture_jpeg_natural_64x64()) catch {
    _ => fail("decode() raised on a JPEG")
  }
  assert_eq((jpeg.width, jpeg.height), (64, 64))
}

///|
test "codec matrix: every JPEG / PNG / GIF / TGA format is decodable" {
  let png = match detect_format(fixture_png_tiny_1x1_rgba()) {
    Some(f) => f
    None => fail("detect_format missed the PNG magic")
  }
  let gif = match detect_format(fixture_gif_tiny_1x1()) {
    Some(f) => f
    None => fail("detect_format missed the GIF magic")
  }
  let tga = match detect_format(fixture_tga_tiny_1x1_24()) {
    Some(f) => f
    None => fail("detect_format missed the TGA magic")
  }
  let jpeg = match detect_format(fixture_jpeg_tiny_1x1()) {
    Some(f) => f
    None => fail("detect_format missed the JPEG magic")
  }
  assert_true(png.is_decodable())
  assert_true(gif.is_decodable())
  assert_true(tga.is_decodable())
  assert_true(jpeg.is_decodable())
}

// ---------------------------------------------------------------------------
// Golden pixel values
//
// The structural assertions above catch dimension / format regressions.
// These catch pixel-level regressions (a swapped channel, a wrong stride,
// a dropped alpha byte) that only show up in the bytes themselves.
//
// The PNG / GIF / TGA values are byte-identical to Pillow's reference
// decode of the same files. The JPEG values are this decoder's own
// deterministic output: the samples are 4:2:0 and this decoder upsamples
// chroma nearest-neighbour, while libjpeg (hence Pillow) uses "fancy"
// triangular upsampling, so chroma differs from Pillow by a few tens of
// units while the luma agrees to within one or two. Both are valid
// 4:2:0 decodes; the golden pins the behaviour we ship.
//
// These bytes also pin the block orientation. The IDCT used to leave
// every 8x8 block transposed, which is invisible on a uniform block and
// wrong on every other one; the golden was regenerated after that fix
// and now fails loudly if the orientation changes again.
// ---------------------------------------------------------------------------

///|
fn assert_leading_bytes(img : Image, expected : Array[Int32]) -> Unit raise {
  assert_true(img.data.length() >= expected.length())
  for i = 0; i < expected.length(); i = i + 1 {
    let got = img.data[i].to_int()
    if got != expected[i] {
      fail(
        "pixel byte " +
        i.to_string() +
        " is " +
        got.to_string() +
        ", expected " +
        expected[i].to_string(),
      )
    }
  }
}

///|
test "golden: png pixels match the reference decode" {
  assert_leading_bytes(
    decode_png(fixture_png_tiny_1x1_rgba()) catch {
      _ => fail("decode_png raised")
    },
    [255, 0, 0, 255],
  )
  assert_leading_bytes(
    decode_png(fixture_png_palette_16x16()) catch {
      _ => fail("decode_png raised")
    },
    [0, 255, 0, 255, 16, 239, 48, 255, 32, 223, 96, 255],
  )
  assert_leading_bytes(
    decode_png(fixture_png_gradient_32x32()) catch {
      _ => fail("decode_png raised")
    },
    [0, 0, 0, 255, 8, 0, 4, 255, 16, 0, 8, 255],
  )
}

///|
test "golden: gif pixels match the reference decode" {
  assert_leading_bytes(
    decode_gif(fixture_gif_tiny_1x1()) catch {
      _ => fail("decode_gif raised")
    },
    [42, 42, 42, 255],
  )
  assert_leading_bytes(
    decode_gif(fixture_gif_palette_32x32()) catch {
      _ => fail("decode_gif raised")
    },
    [0, 255, 0, 255, 8, 247, 56, 255, 16, 239, 112, 255],
  )
  assert_leading_bytes(
    decode_gif(fixture_gif_animated_8x8()) catch {
      _ => fail("decode_gif raised")
    },
    [255, 0, 0, 255, 255, 0, 0, 255, 255, 0, 0, 255],
  )
}

///|
test "golden: tga pixels match the reference decode" {
  assert_leading_bytes(
    decode_tga(fixture_tga_tiny_1x1_24()) catch {
      _ => fail("decode_tga raised")
    },
    [0, 255, 0, 255],
  )
  assert_leading_bytes(
    decode_tga(fixture_tga_grayscale_32x32()) catch {
      _ => fail("decode_tga raised")
    },
    [0, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88],
  )
  assert_leading_bytes(
    decode_tga(fixture_tga_rgba_32x32()) catch {
      _ => fail("decode_tga raised")
    },
    [0, 0, 0, 255, 8, 0, 4, 255, 16, 0, 8, 255],
  )
}

///|
test "golden: jpeg pixels match this decoder's deterministic output" {
  assert_leading_bytes(
    decode_jpeg(fixture_jpeg_tiny_1x1()) catch {
      _ => fail("decode_jpeg raised")
    },
    [10, 20, 30],
  )
  assert_leading_bytes(
    decode_jpeg(fixture_jpeg_natural_64x64()) catch {
      _ => fail("decode_jpeg raised")
    },
    [
      3, 0, 0, 4, 0, 0, 9, 0, 1, 11, 2, 3, 15, 2, 9, 17, 4, 11, 24, 2, 15, 25, 3,
      16,
    ],
  )
  assert_leading_bytes(
    decode_jpeg(fixture_jpeg_hq_64x64()) catch {
      _ => fail("decode_jpeg raised")
    },
    [
      1, 0, 6, 2, 1, 7, 2, 3, 7, 5, 6, 10, 5, 10, 6, 7, 12, 8, 6, 16, 7, 7, 17, 8,
    ],
  )
}
