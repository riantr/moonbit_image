# MoonBit build artifacts
target/
_build/
.moonbit/
.moonagent/
pkg.generated.mbti

# Mooncakes cache
.mooncakes/

# Local publish logs (failed local `moon publish` attempts)
publish_*.log
pub_*.log

# Every log file: the release CI writes its publish logs into the
# checkout, and `moon publish` packages the whole directory, so an
# ignored file is also a file that stays out of the released package.
*.log

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Python bytecode from the scripts under .tools/
__pycache__/
*.pyc

# LunaFlow / static-analysis reports. `moonx riantr/LunaFlow@latest .` writes
# a Markdown report, a summary JSON and a JSONL trace into `reports/`; the
# trace is tens of megabytes, and `moon publish` packages the working
# directory, so this directory must never reach the released package.
reports/
